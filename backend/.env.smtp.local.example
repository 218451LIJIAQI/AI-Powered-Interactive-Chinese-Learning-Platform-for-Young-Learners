# Copy this file to .env.smtp.local and fill only your SMTP account values.
# .env.smtp.local is ignored by Git and must never be committed.

SMTP_ENABLED=true
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-authorization-code-or-app-password

# Optional. If empty, the startup script uses SMTP_USERNAME as the sender.
SMTP_FROM=

# Optional for common providers. The startup script can infer host/port for
# gmail.com, outlook.com, hotmail.com, live.com, qq.com, 163.com, 126.com,
# icloud.com, yahoo.com, and sina.com. For custom domains, fill SMTP_HOST.
SMTP_HOST=
SMTP_PORT=

# Defaults are for port 587 STARTTLS. The startup script changes these for
# providers that commonly require port 465 SSL.
SMTP_AUTH_ENABLED=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL_ENABLED=false

SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
