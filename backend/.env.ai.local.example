# Copy this file to .env.ai.local and fill your AI API key.
# .env.ai.local is ignored by Git and must never be committed.

AI_ENABLE_REAL_PROVIDER=true

# Default provider: DeepSeek Chat Completions API.
AI_PROVIDER=deepseek
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL_NAME=deepseek-chat
AI_API_KEY=your-deepseek-api-key

AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1200

# OpenAI-compatible example:
# AI_PROVIDER=openai-compatible
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL_NAME=gpt-4o-mini
# AI_API_KEY=your-openai-api-key

# Local OpenAI-compatible server example, such as Ollama-compatible proxies:
# AI_PROVIDER=openai-compatible
# AI_API_BASE_URL=http://localhost:11434/v1
# AI_MODEL_NAME=your-local-model
# AI_API_KEY=local-development-key
