{
  "name": "mandarin-spark-workspace",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "frontend/**/*.{ts,vue,js,mjs}": "npm --prefix frontend exec eslint --fix --",
    "frontend/**/*.{ts,vue,js,mjs,json,css,md,yml,yaml}": "npm --prefix frontend exec prettier --write --",
    "*.{md,yml,yaml,json}": "npx prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5"
  }
}
