# Copy to .env.external-e2e for local live-provider smoke tests.
# Keep this file as placeholders only; never commit real provider credentials.

# AI real-provider E2E
AI_ENABLE_REAL_PROVIDER=true
AI_PROVIDER=deepseek
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace-with-ai-api-key
AI_MODEL_NAME=deepseek-chat
EXTERNAL_E2E_AI_TEST_PROMPT=Say hello in simple Mandarin for a young learner.

# Stripe test-mode E2E
PAYMENT_PROVIDER=stripe
STRIPE_API_KEY=sk_test_replace-with-stripe-test-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-webhook-secret
PAYMENT_SUCCESS_URL=http://localhost:4173/payment/success
PAYMENT_CANCEL_URL=http://localhost:4173/payment/cancel
EXTERNAL_E2E_STRIPE_WEBHOOK_FORWARDING=replace-with-stripe-cli-or-tunnel-session-id

# SMTP real-delivery E2E
SMTP_ENABLED=true
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_AUTH_ENABLED=true
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=MandarinSpark <no-reply@example.com>
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLED=false
PASSWORD_RESET_BASE_URL=http://localhost:4173/reset-password
EXTERNAL_E2E_SMTP_TEST_RECIPIENT=replace-with-controlled-test-inbox@example.com
