DB_ROOT_PASSWORD=
DB_NAME=ai_chinese_learning
DB_USERNAME=aichinese_app
DB_PASSWORD=
DB_MAX_POOL_SIZE=30
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT=30s
ASYNC_CORE_POOL_SIZE=2
ASYNC_MAX_POOL_SIZE=4
ASYNC_QUEUE_CAPACITY=100

JWT_SECRET=
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_REFRESH_COOKIE_NAME=mandarin_spark_refresh
JWT_REFRESH_COOKIE_SECURE=true
JWT_REFRESH_COOKIE_SAME_SITE=Strict
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCK_DURATION_MINUTES=15
LOGIN_MAX_TRACKED_RECORDS=10000
REGISTER_REQUESTS_PER_WINDOW=100
FORGOT_PASSWORD_REQUESTS_PER_WINDOW=10
PUBLIC_AUTH_WINDOW_MINUTES=15
PUBLIC_AUTH_MAX_TRACKED_RECORDS=10000
# Keep the proxy IP within APP_NETWORK_SUBNET; only this hop may supply the
# original client address used for audit records and auth rate limits.
APP_NETWORK_SUBNET=172.28.0.0/24
FRONTEND_PROXY_IP=172.28.0.10
APP_SECURITY_FORWARDED_TRUSTED_PROXIES=172.28.0.10
FRONTEND_BASE_URL=https://learn.example.com
APP_CORS_ALLOWED_ORIGINS=https://learn.example.com
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10MB
MAX_VERIFICATION_DOCUMENT_FILE_SIZE=5MB
MAX_AI_AUDIO_FILE_SIZE=10MB
MAX_AI_IMAGE_FILE_SIZE=10MB
RECORDED_VIDEO_UPLOAD_DIR=/app/uploads/recorded-videos
MAX_VIDEO_FILE_SIZE=100MB

AI_ENABLE_REAL_PROVIDER=true
AI_PROVIDER=deepseek
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL_NAME=deepseek-chat
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=100

PAYMENT_PROVIDER=stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=https://learn.example.com/payment/success
PAYMENT_CANCEL_URL=https://learn.example.com/payment/cancel

SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@learn.example.com
SMTP_AUTH_ENABLED=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLED=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
PASSWORD_RESET_BASE_URL=https://learn.example.com/reset-password

# Expose prometheus only behind an internal or authenticated scraper.
MANAGEMENT_EXPOSED_ENDPOINTS=health,info
FRONTEND_PORT=8080

SENTRY_DSN=
VITE_SENTRY_DSN=
APP_ENVIRONMENT=production
APP_RELEASE=
VITE_GIT_SHA=
