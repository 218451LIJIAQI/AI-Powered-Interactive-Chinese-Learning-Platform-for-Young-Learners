VITE_API_BASE_URL=/api/v1
VITE_USE_DEMO_DATA=false
VITE_ENABLE_PREVIEW_MODE=false

# For FYP presentation without a running backend, copy this file to
# .env.local and set both values below to true. This enables the
# read-only Preview Student / Teacher / Admin buttons on the sign-in page.
# VITE_USE_DEMO_DATA=true
# VITE_ENABLE_PREVIEW_MODE=true
