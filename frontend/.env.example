VITE_API_BASE_URL=/api/v1
# Optional error monitoring; Sentry stays disabled while the DSN is empty.
VITE_SENTRY_DSN=
VITE_APP_RELEASE=

# The dev server proxies /api/v1 to the backend on http://127.0.0.1:8080. To point it elsewhere, set
# VITE_API_PROXY_TARGET in the shell that starts `npm run dev` (vite.config.ts reads the process environment, not
# this file); the end-to-end tests do that for their own backend port.
